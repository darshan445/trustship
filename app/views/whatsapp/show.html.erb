<% content_for :title, "WhatsApp — TrustShip" %>
<% content_for :page_title, "WhatsApp" %>

<div class="space-y-6">
  <section class="rounded-xl border border-gray-200 bg-white p-6">
    <h2 class="text-lg font-semibold text-gray-900">WhatsApp Business Connection</h2>
    <p class="mt-1 text-sm text-gray-600">
      Connect your WhatsApp Business account using Meta Embedded Signup so TrustShip can receive chats and create orders automatically.
    </p>

    <div class="mt-4 rounded-lg bg-gray-50 p-4 text-sm">
      <p>
        <span class="font-medium text-gray-700">Status:</span>
        <% if @seller.whatsapp_connected? %>
          <span class="ml-1 inline-flex rounded-full bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-700">Connected</span>
        <% elsif @seller.pending? %>
          <span class="ml-1 inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700">Pending</span>
        <% elsif @seller.failed? %>
          <span class="ml-1 inline-flex rounded-full bg-red-100 px-2 py-0.5 text-xs font-semibold text-red-700">Failed</span>
        <% else %>
          <span class="ml-1 inline-flex rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700">Not connected</span>
        <% end %>
      </p>
      <% if @seller.whatsapp_connected? %>
        <p class="mt-2 text-gray-700">WABA ID: <span class="font-mono text-xs"><%= @seller.whatsapp_waba_id %></span></p>
        <p class="mt-1 text-gray-700">Phone Number ID: <span class="font-mono text-xs"><%= @seller.whatsapp_phone_number_id %></span></p>
        <p class="mt-1 text-gray-700">Display Number: <span class="font-medium"><%= @seller.whatsapp_display_phone_number.presence || "—" %></span></p>
      <% end %>
    </div>

    <% if @embedded_config_id.present? && @facebook_app_id.present? %>
      <div
        class="mt-4"
        data-controller="whatsapp-embedded-signup"
        data-whatsapp-embedded-signup-config-id-value="<%= @embedded_config_id %>"
        data-whatsapp-embedded-signup-app-id-value="<%= @facebook_app_id %>"
        data-whatsapp-embedded-signup-complete-url-value="<%= whatsapp_embedded_signup_complete_path %>">
        <button
          type="button"
          data-action="click->whatsapp-embedded-signup#start"
          class="btn-primary">
          <i class="ti ti-brand-whatsapp text-sm"></i>
          <%= @seller.whatsapp_connected? ? "Reconnect WhatsApp" : "Connect WhatsApp Business" %>
        </button>
        <p class="mt-2 text-xs text-gray-500" data-whatsapp-embedded-signup-target="message"></p>
      </div>
    <% else %>
      <div class="mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
        Missing embedded signup configuration. Add `meta.whatsapp_embedded_config_id` and `meta.facebook_app_id` in credentials.
      </div>
    <% end %>
  </section>
</div>
