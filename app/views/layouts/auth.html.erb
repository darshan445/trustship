<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <title><%= content_for(:title) || "TrustShip" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-gray-100">
    <div class="flex min-h-screen flex-col items-center justify-center px-4 py-10">
      <div class="mb-8 w-full max-w-md text-center">
        <h1 class="text-2xl font-bold text-indigo-600">TrustShip</h1>
        <p class="mt-2 text-sm text-gray-600">RTO Protection for WhatsApp Sellers</p>
      </div>

      <div class="w-full max-w-md rounded-xl bg-white p-8 shadow-lg shadow-gray-200/50">
        <% if notice.present? %>
          <div class="mb-4 rounded-lg bg-green-50 px-3 py-2 text-center text-sm text-green-800" role="status"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-center text-sm text-red-800" role="alert"><%= alert %></div>
        <% end %>
        <%= yield %>
      </div>
    </div>
  </body>
</html>
