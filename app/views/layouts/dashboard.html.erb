<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "TrustShip" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "dashboard", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
    <%= javascript_importmap_tags %>
  </head>
  <body class="text-gray-900 antialiased" data-controller="sidebar">
    <div class="flex h-screen overflow-hidden bg-gray-50">
      <div data-sidebar-target="overlay" data-action="click->sidebar#close" class="fixed inset-0 z-30 hidden bg-black/30 md:hidden"></div>

      <aside id="sidebar" data-sidebar-target="panel" class="fixed inset-y-0 left-0 z-40 hidden w-[220px] -translate-x-full border-r border-gray-200 bg-white transition-transform duration-200 md:static md:block md:translate-x-0">
        <div class="flex h-full flex-col px-3 py-4">
          <div class="px-2 pb-4">
            <%= link_to "TrustShip", dashboard_path, class: "text-[18px] font-medium text-[#534AB7]" %>
          </div>

          <nav class="space-y-1">
            <%= link_to orders_path, class: "sidebar-nav-item #{dashboard_sidebar_active(:orders)}" do %>
              <i class="ti ti-package text-base"></i>
              <span>Orders</span>
              <% if dashboard_pending_orders_count.positive? %>
                <span class="ml-auto rounded-full bg-[#EEEDFE] px-2 py-0.5 text-[10px] font-semibold text-[#534AB7]"><%= dashboard_pending_orders_count %></span>
              <% end %>
            <% end %>

            <%= link_to products_path, class: "sidebar-nav-item #{dashboard_sidebar_active(:products)}" do %>
              <i class="ti ti-box text-base"></i>
              <span>Products</span>
            <% end %>

            <%= link_to buyers_path, class: "sidebar-nav-item #{dashboard_sidebar_active(:buyers)}" do %>
              <i class="ti ti-users text-base"></i>
              <span>Buyers</span>
            <% end %>

            <p class="px-2 pt-2 text-[11px] font-medium uppercase tracking-wide text-gray-400">Account</p>

            <%= link_to account_path, class: "sidebar-nav-item #{dashboard_sidebar_active(:settings)}" do %>
              <i class="ti ti-settings text-base"></i>
              <span>Settings</span>
            <% end %>

            <%= link_to whatsapp_path, class: "sidebar-nav-item #{dashboard_sidebar_active(:whatsapp)}" do %>
              <i class="ti ti-brand-whatsapp text-base"></i>
              <span>WhatsApp</span>
            <% end %>

            <%= link_to "#", class: "sidebar-nav-item" do %>
              <i class="ti ti-help-circle text-base"></i>
              <span>Help</span>
            <% end %>
          </nav>

          <div class="mt-auto pt-4">
            <details class="group relative">
              <summary class="flex list-none cursor-pointer items-center gap-3 rounded-lg border border-gray-100 bg-gray-50 px-3 py-2 [&::-webkit-details-marker]:hidden">
                <div class="flex h-9 w-9 items-center justify-center rounded-full bg-[#EEEDFE] text-xs font-semibold text-[#534AB7]">
                  <%= initials_for_business(current_seller.business_name) %>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-semibold text-gray-900"><%= current_seller.business_name %></p>
                  <p class="text-xs text-gray-500">Early Access</p>
                </div>
                <i class="ti ti-chevron-down text-sm text-gray-500"></i>
              </summary>
              <div class="absolute bottom-full left-0 mb-2 w-full rounded-lg border border-gray-100 bg-white py-1 shadow-lg">
                <%= link_to "Account Settings", account_path, class: "block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
                <%= button_to "Sign Out", destroy_seller_session_path, method: :delete, class: "block w-full px-3 py-2 text-left text-sm text-gray-700 hover:bg-gray-50" %>
              </div>
            </details>
          </div>
        </div>
      </aside>

      <div class="flex flex-1 flex-col overflow-hidden">
        <header class="flex h-14 items-center justify-between border-b border-gray-200 bg-white px-4 md:px-6">
          <div class="flex items-center gap-3">
            <button type="button" data-action="click->sidebar#toggle" class="rounded-md p-1.5 text-gray-600 hover:bg-gray-100 md:hidden" aria-label="Toggle navigation">
              <i class="ti ti-menu-2 text-lg"></i>
            </button>
            <h1 class="text-base font-semibold text-gray-900"><%= content_for?(:page_title) ? yield(:page_title) : "Dashboard" %></h1>
          </div>
          <div class="flex items-center gap-2">
            <%= yield :topbar_actions if content_for?(:topbar_actions) %>
          </div>
        </header>

        <% if notice.present? %>
          <div class="border-b border-green-100 bg-green-50 px-4 py-2 text-sm text-green-800" data-controller="flash" role="status"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="border-b border-red-100 bg-red-50 px-4 py-2 text-sm text-red-800" data-controller="flash" role="alert"><%= alert %></div>
        <% end %>

        <main class="flex-1 overflow-y-auto p-4 pb-24 md:p-6 md:pb-6">
          <%= yield %>
        </main>
      </div>

      <nav id="mobile-bottom-nav" data-sidebar-target="mobileNav" class="fixed bottom-0 left-0 right-0 z-30 border-t border-gray-200 bg-white md:hidden">
        <div class="grid grid-cols-4 gap-1 px-2 py-2">
          <%= link_to orders_path, class: dashboard_mobile_nav_classes(controller_name == "orders") do %>
            <i class="ti ti-package text-lg"></i><span class="text-[11px]">Orders</span>
          <% end %>
          <%= link_to products_path, class: dashboard_mobile_nav_classes(controller_name == "products") do %>
            <i class="ti ti-box text-lg"></i><span class="text-[11px]">Products</span>
          <% end %>
          <%= link_to account_path, class: dashboard_mobile_nav_classes(controller_name == "account") do %>
            <i class="ti ti-settings text-lg"></i><span class="text-[11px]">Settings</span>
          <% end %>
          <%= link_to account_path, class: dashboard_mobile_nav_classes(controller_name == "account" && action_name == "show") do %>
            <i class="ti ti-user text-lg"></i><span class="text-[11px]">Account</span>
          <% end %>
        </div>
      </nav>
    </div>
  </body>
</html>
