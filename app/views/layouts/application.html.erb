<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <title><%= content_for(:title) || "TrustShip" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="TrustShip">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-white text-gray-900 antialiased">
    <% unless controller_name == "pages" && action_name == "home" %>
      <header class="sticky top-0 z-20 border-b border-gray-100 bg-white">
        <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4" aria-label="Main">
          <%= link_to root_path, class: "flex min-w-0 shrink items-baseline gap-3" do %>
            <span class="text-xl font-bold tracking-tight text-indigo-600">TrustShip</span>
            <span class="hidden text-sm font-medium text-gray-500 md:inline">RTO Protection Shield</span>
          <% end %>

          <div class="flex flex-shrink-0 items-center gap-2 sm:gap-3">
            <% if seller_signed_in? %>
              <%= link_to "Dashboard", dashboard_path, class: "rounded-lg px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600" %>
              <%= button_to "Sign out", destroy_seller_session_path, method: :delete, class: "rounded-lg border border-indigo-600 bg-white px-4 py-2.5 text-sm font-medium text-indigo-600 shadow-sm hover:bg-indigo-50" %>
            <% else %>
              <%= link_to "Sign in", new_seller_session_path, class: "rounded-lg border border-indigo-600 bg-white px-4 py-2.5 text-sm font-medium text-indigo-600 shadow-sm hover:bg-indigo-50" %>
              <%= link_to "Join Early Access", new_seller_registration_path, class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 sm:px-5" %>
            <% end %>
          </div>
        </nav>
      </header>
    <% end %>

    <% if notice.present? %>
      <div class="border-b border-green-100 bg-green-50 px-4 py-3 text-center text-sm text-green-800" role="status"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="border-b border-red-100 bg-red-50 px-4 py-3 text-center text-sm text-red-800" role="alert"><%= alert %></div>
    <% end %>

    <% landing = controller_name == "pages" && action_name == "home" %>
    <main class="<%= landing ? "w-full flex-1" : "mx-auto w-full max-w-3xl flex-1 px-4 py-10" %>">
      <%= yield %>
    </main>

    <% unless seller_signed_in? %>
      <% if controller_name != "pages" || action_name != "home" %>
      <footer class="bg-gray-900">
        <div class="mx-auto max-w-6xl px-4 pb-8 pt-16">
          <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4">
            <div>
              <p class="mb-3 text-xl font-bold text-white">TrustShip</p>
              <p class="mb-6 text-sm leading-relaxed text-gray-400">
                The shipping platform built for WhatsApp sellers.
              </p>
              <div class="space-y-2 text-sm text-gray-400">
                <div class="flex items-center gap-2">
                  <span aria-hidden="true">✉️</span>
                  <%= link_to "contact@trustship.site", "mailto:contact@trustship.site", class: "transition-colors hover:text-white" %>
                </div>
              </div>
            </div>

            <div>
              <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">Product</h2>
              <nav class="space-y-3" aria-label="Product">
                <%= link_to "How it works", root_path(anchor: "how-it-works"), class: "block text-sm text-gray-400 transition-colors hover:text-white" %>
                <%= link_to "Features", root_path(anchor: "features"), class: "block text-sm text-gray-400 transition-colors hover:text-white" %>
                <%= link_to "Early access", root_path(anchor: "pricing"), class: "block text-sm text-gray-400 transition-colors hover:text-white" %>
                <%= link_to "Sign in", new_seller_session_path, class: "block text-sm text-gray-400 transition-colors hover:text-white" %>
                <%= link_to "Join Early Access", new_seller_registration_path, class: "block text-sm text-gray-400 transition-colors hover:text-white" %>
              </nav>
            </div>

            <div>
              <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">Legal</h2>
              <nav class="space-y-3" aria-label="Legal">
                <%= link_to "Terms & Conditions", terms_path, class: "block text-sm text-gray-400 transition-colors hover:text-white" %>
                <%= link_to "Privacy Policy", privacy_path, class: "block text-sm text-gray-400 transition-colors hover:text-white" %>
                <%= link_to "Refund Policy", refund_path, class: "block text-sm text-gray-400 transition-colors hover:text-white" %>
                <%= link_to "Cookie Policy", cookies_path, class: "block text-sm text-gray-400 transition-colors hover:text-white" %>
                <%= link_to "Shipping Policy", shipping_policy_path, class: "block text-sm text-gray-400 transition-colors hover:text-white" %>
              </nav>
            </div>

            <div>
              <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">Contact</h2>
              <div class="space-y-1 text-sm leading-relaxed text-gray-400">
                <p>Darshan Thakor</p>
                <p>TrustShip (sole proprietorship)</p>
                <%= link_to support_email, "mailto:#{support_email}", class: "block transition-colors hover:text-white" %>
              </div>
            </div>
          </div>
        </div>

        <div class="border-t border-gray-800 px-4 py-6">
          <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 text-sm text-gray-500 md:flex-row">
            <p>© 2026 TrustShip. All rights reserved.</p>
            <p class="text-center md:text-right">Operated by Darshan Thakor (Sole Proprietorship)</p>
          </div>
        </div>
      </footer>
      <% end %>
    <% end %>
  </body>
</html>
