<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <title><%= content_for(:title) || "TrustShip" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="TrustShip">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-white text-gray-900 antialiased">
    <header class="sticky top-0 z-20 border-b border-gray-100 bg-white">
      <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4" aria-label="Main">
        <%= link_to root_path, class: "flex min-w-0 shrink items-baseline gap-3" do %>
          <span class="text-xl font-bold tracking-tight text-indigo-600">TrustShip</span>
          <span class="hidden text-sm font-medium text-gray-500 md:inline">RTO Protection Shield</span>
        <% end %>

        <div class="flex flex-shrink-0 items-center gap-2 sm:gap-3">
          <% if seller_signed_in? %>
            <%= link_to "Dashboard", dashboard_path, class: "rounded-lg px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600" %>
            <%= button_to "Sign out", destroy_seller_session_path, method: :delete, class: "rounded-lg border border-indigo-600 bg-white px-4 py-2.5 text-sm font-medium text-indigo-600 shadow-sm hover:bg-indigo-50" %>
          <% else %>
            <%= link_to "Sign in", new_seller_session_path, class: "rounded-lg border border-indigo-600 bg-white px-4 py-2.5 text-sm font-medium text-indigo-600 shadow-sm hover:bg-indigo-50" %>
            <%= link_to "Get Started Free", new_seller_registration_path, class: "rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 sm:px-5" %>
          <% end %>
        </div>
      </nav>
    </header>

    <% if notice.present? %>
      <div class="border-b border-green-100 bg-green-50 px-4 py-3 text-center text-sm text-green-800" role="status"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="border-b border-red-100 bg-red-50 px-4 py-3 text-center text-sm text-red-800" role="alert"><%= alert %></div>
    <% end %>

    <% landing = controller_name == "pages" && action_name == "home" %>
    <main class="<%= landing ? "w-full" : "mx-auto max-w-3xl px-4 py-10" %>">
      <%= yield %>
    </main>
  </body>
</html>
