<% content_for :title, "TrustShip — Every WhatsApp order, verified automatically" %>

<header class="fixed left-0 right-0 top-0 z-50 h-16 bg-white shadow-sm" data-controller="navbar">
  <div class="relative mx-auto flex h-full max-w-6xl items-center justify-between px-4">
    <%= link_to root_path, class: "text-xl font-bold text-indigo-600" do %>
      TrustShip
    <% end %>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      <a href="#how-it-works" class="text-sm font-medium text-gray-700 hover:text-indigo-600">How it works</a>
      <a href="#pricing" class="text-sm font-medium text-gray-700 hover:text-indigo-600">Early access</a>
      <% if seller_signed_in? %>
        <%= link_to "Dashboard", dashboard_path, class: "rounded-lg px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-indigo-600" %>
        <%= button_to "Sign out", destroy_seller_session_path, method: :delete, form: { class: "inline" }, class: "rounded-lg border border-indigo-600 bg-white px-4 py-2 text-sm font-medium text-indigo-600 shadow-sm hover:bg-indigo-50" %>
      <% else %>
        <%= link_to "Sign in", new_seller_session_path, class: "rounded-lg border border-indigo-600 bg-white px-4 py-2 text-sm font-medium text-indigo-600 shadow-sm hover:bg-indigo-50" %>
        <%= link_to "Join Early Access", new_seller_registration_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      <% end %>
    </nav>

    <button
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-gray-700 hover:bg-gray-100 md:hidden"
      data-action="click->navbar#toggle"
      aria-controls="navbar-mobile-menu"
      aria-expanded="false"
      aria-label="Open menu">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>

    <div
      id="navbar-mobile-menu"
      class="absolute left-0 right-0 top-full hidden max-h-[min(70vh,calc(100dvh-4rem))] overflow-y-auto border-t border-gray-100 bg-white shadow-lg md:hidden"
      data-navbar-target="menu">
      <nav class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-4" aria-label="Mobile">
        <a href="#how-it-works" class="text-sm font-medium text-gray-700 hover:text-indigo-600" data-action="click->navbar#close">How it works</a>
        <a href="#pricing" class="text-sm font-medium text-gray-700 hover:text-indigo-600" data-action="click->navbar#close">Early access</a>
        <div class="flex flex-col gap-2 border-t border-gray-100 pt-4">
          <% if seller_signed_in? %>
            <%= link_to "Dashboard", dashboard_path, class: "w-full rounded-lg py-2.5 text-center text-sm font-medium text-gray-700 hover:bg-gray-50", data: { action: "click->navbar#close" } %>
            <%= button_to "Sign out", destroy_seller_session_path, method: :delete, form: { class: "w-full" }, class: "w-full rounded-lg border border-indigo-600 bg-white py-2.5 text-sm font-medium text-indigo-600 shadow-sm hover:bg-indigo-50" %>
          <% else %>
            <%= link_to "Sign in", new_seller_session_path, class: "block w-full rounded-lg border border-indigo-600 bg-white py-2.5 text-center text-sm font-medium text-indigo-600 shadow-sm hover:bg-indigo-50", data: { action: "click->navbar#close" } %>
            <%= link_to "Join Early Access", new_seller_registration_path, class: "block w-full rounded-lg bg-indigo-600 py-2.5 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500", data: { action: "click->navbar#close" } %>
          <% end %>
        </div>
      </nav>
    </div>
  </div>
</header>
<div class="h-16 shrink-0" aria-hidden="true"></div>

<div class="bg-white">
  <section class="mx-auto max-w-6xl px-4 py-12 md:py-20" aria-labelledby="hero-heading">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-12">
      <div class="text-center md:text-left">
        <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-indigo-600">For small shops on WhatsApp &amp; Instagram</p>
        <h1 id="hero-heading" class="mb-6 text-4xl font-bold leading-tight text-gray-900 md:text-5xl">
          Every WhatsApp Order. Automatically Verified.
        </h1>
        <p class="mx-auto mb-8 max-w-xl text-lg leading-relaxed text-gray-600 md:mx-0">
          TrustShip connects to your WhatsApp, converts messy order messages into clean orders, and verifies every buyer before you ship — so you never waste money on a return again.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <%= link_to "Join Early Access — It's Free", new_seller_registration_path, class: "inline-flex justify-center rounded-lg bg-indigo-600 px-6 py-3 font-medium text-white transition-colors hover:bg-indigo-700" %>
          <a href="#how-it-works" class="inline-flex justify-center rounded-lg border border-indigo-600 px-6 py-3 font-medium text-indigo-600 transition-colors hover:bg-indigo-50">See How It Works</a>
        </div>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-x-1 gap-y-2 text-sm text-gray-500 md:justify-start">
          <span>✓ Messy chat → clean order (AI)</span>
          <span class="px-1.5" aria-hidden="true">·</span>
          <span>✓ RTO checks before you ship</span>
          <span class="px-1.5" aria-hidden="true">·</span>
          <span>✓ Free during Early Access</span>
        </div>
      </div>
      <div class="mx-auto w-full max-w-md lg:mx-0 lg:max-w-none" aria-hidden="true">
        <div class="grid gap-4 sm:grid-cols-[1fr_auto_1fr] sm:items-center sm:gap-3">
          <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wide text-emerald-800">WhatsApp</p>
            <div class="mt-2 rounded-xl rounded-tl-sm border border-emerald-300/80 bg-[#DCF8C6] px-3 py-3 text-left text-sm leading-relaxed text-gray-800">
              <p>Need 2 tops size M,</p>
              <p>postal 30201, COD please</p>
              <p class="text-gray-600">alex — chat reply 🙏</p>
            </div>
            <p class="mt-2 text-xs text-emerald-900/80">What buyers actually send</p>
          </div>

          <div class="hidden items-center justify-center sm:flex" aria-hidden="true">
            <span class="text-2xl font-bold text-indigo-400">→</span>
          </div>
          <div class="flex justify-center sm:hidden" aria-hidden="true">
            <span class="text-2xl font-bold text-indigo-400">↓</span>
          </div>

          <div class="rounded-2xl border border-indigo-100 bg-white p-4 shadow-md sm:col-span-1 sm:col-start-3 sm:row-start-1">
            <p class="text-xs font-bold uppercase tracking-wide text-indigo-600">TrustShip</p>
            <p class="mt-1 text-xs text-gray-500">Clean order · ready for you</p>
            <dl class="mt-3 space-y-2 text-sm">
              <div class="flex justify-between gap-2 border-b border-gray-100 pb-2">
                <dt class="text-gray-500">Buyer</dt>
                <dd class="font-medium text-gray-900">Alex · +1 234 567 8901</dd>
              </div>
              <div class="flex justify-between gap-2 border-b border-gray-100 pb-2">
                <dt class="text-gray-500">Product</dt>
                <dd class="font-medium text-gray-900">Top · M</dd>
              </div>
              <div class="flex justify-between gap-2 border-b border-gray-100 pb-2">
                <dt class="text-gray-500">Address</dt>
                <dd class="text-right font-medium text-gray-900">Metro, 30201</dd>
              </div>
              <div class="flex justify-between gap-2 pb-1">
                <dt class="text-gray-500">Payment</dt>
                <dd class="font-medium text-gray-900">COD</dd>
              </div>
            </dl>
            <p class="mt-3 inline-flex w-full justify-center rounded-full bg-green-100 px-3 py-1.5 text-center text-xs font-semibold text-green-800">Verified — safe to ship</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

