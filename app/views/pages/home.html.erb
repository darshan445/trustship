    <% w = Order::WEIGHT_TIERS %>
    <h2 id="pricing-heading" class="text-3xl font-bold text-gray-900 sm:text-4xl">
      One price. Everything included.
    </h2>
    <p class="mt-3 max-w-2xl text-base font-medium text-gray-600 sm:text-lg">
      No monthly fee. No setup cost. Pay only when you ship.
    </p>

    <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
