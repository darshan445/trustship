    <div class="mt-10 text-center">
      <%= link_to "Start Shipping Today →", new_seller_registration_path, class: "inline-flex justify-center rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
      <p class="mt-3 text-xs text-gray-500">No monthly fee · No setup cost · Pay only when you ship</p>
