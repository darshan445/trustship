        <p class="mt-3 text-4xl font-bold text-indigo-600">₹<%= w[2000] %></p>
        <p class="mt-1 text-sm text-gray-600">per shipment</p>
      </article>
      <article class="rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-gray-500">2kg — 5kg</p>
        <p class="mt-3 text-4xl font-bold text-indigo-600">₹<%= w[5000] %></p>
