<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Sellers</h1>
    <p class="mt-1 text-sm text-gray-500"><%= Time.current.strftime("%b %d, %Y · %I:%M %p %Z") %></p>
  </div>

  <div class="flex gap-3">
    <div class="rounded-xl border border-gray-200 bg-white px-5 py-3 text-center shadow-sm">
      <p class="text-2xl font-bold text-gray-900"><%= @total_sellers %></p>
      <p class="mt-0.5 text-xs text-gray-500">Total</p>
    </div>
    <div class="rounded-xl border border-gray-200 bg-white px-5 py-3 text-center shadow-sm">
      <p class="text-2xl font-bold text-green-700"><%= @active_sellers %></p>
      <p class="mt-0.5 text-xs text-gray-500">Active</p>
    </div>
    <div class="rounded-xl border border-gray-200 bg-white px-5 py-3 text-center shadow-sm">
      <p class="text-2xl font-bold text-indigo-700"><%= @wa_connected %></p>
      <p class="mt-0.5 text-xs text-gray-500">WA Connected</p>
    </div>
  </div>
</div>

<div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
  <% if @sellers.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-100 text-sm">
        <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
          <tr>
            <th class="px-4 py-3">#</th>
            <th class="px-4 py-3">Name / Business</th>
            <th class="px-4 py-3">Email</th>
            <th class="px-4 py-3">Phone</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">WhatsApp</th>
            <th class="px-4 py-3">Early Access</th>
            <th class="px-4 py-3">Joined</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-gray-700">
          <% @sellers.each_with_index do |seller, i| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-xs text-gray-400"><%= @total_sellers - i %></td>
              <td class="px-4 py-3">
                <p class="font-semibold text-gray-900"><%= seller.name %></p>
                <p class="text-xs text-gray-500"><%= seller.business_name %></p>
              </td>
              <td class="px-4 py-3 font-mono text-xs"><%= seller.email %></td>
              <td class="px-4 py-3 text-xs"><%= seller.phone.presence || "—" %></td>
              <td class="px-4 py-3">
                <% if seller.status == "active" %>
                  <span class="inline-flex rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-700">Active</span>
                <% else %>
                  <span class="inline-flex rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-600">Inactive</span>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <% case seller.whatsapp_onboarding_status %>
                <% when "connected" %>
                  <span class="inline-flex rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">Connected</span>
                  <% if seller.whatsapp_display_phone_number.present? %>
                    <p class="mt-0.5 text-[11px] text-gray-500"><%= seller.whatsapp_display_phone_number %></p>
                  <% end %>
                <% when "pending" %>
                  <span class="inline-flex rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-700">Pending</span>
                <% when "failed" %>
                  <span class="inline-flex rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-semibold text-red-700">Failed</span>
                <% else %>
                  <span class="inline-flex rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-500">Not connected</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-center">
                <% if seller.early_access? %>
                  <span class="text-indigo-500">✓</span>
                <% else %>
                  <span class="text-gray-300">—</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-xs text-gray-500">
                <%= seller.created_at.strftime("%b %d, %Y") %>
                <p class="text-[11px] text-gray-400"><%= time_ago_in_words(seller.created_at) %> ago</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="py-16 text-center text-gray-500">
      <p class="text-lg font-medium">No sellers yet</p>
    </div>
  <% end %>
</div>
