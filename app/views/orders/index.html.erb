<% content_for :title, "Orders — TrustShip" %>

<h1 class="text-2xl font-bold text-gray-900">Orders</h1>

<% w = Order::WEIGHT_TIERS %>
<% tier_rows = [
  [ "Upto 500g", w[500] ],
  [ "500g-1kg", w[1000] ],
  [ "1kg-2kg", w[2000] ],
  [ "2kg-5kg", w[5000] ]
] %>
<section class="mt-6 rounded-xl border border-gray-100 bg-white p-5 shadow-sm">
  <h2 class="text-lg font-bold text-gray-900">Your Shipping Rates</h2>
  <p class="mt-1 text-sm text-gray-600">All inclusive — no hidden charges</p>
  <div class="mt-4 overflow-x-auto">
    <table class="w-full min-w-[280px] text-left text-sm">
      <thead>
        <tr class="border-b border-gray-200 text-gray-500">
          <th class="pb-2 pr-3 font-medium">Weight</th>
          <th class="pb-2 pr-3 font-medium">COD</th>
          <th class="pb-2 font-medium">UPI Payment</th>
        </tr>
      </thead>
      <tbody class="text-gray-900">
        <% tier_rows.each do |label, rates| %>
          <tr class="border-b border-gray-100 last:border-0">
            <td class="py-2 pr-3"><%= label %></td>
            <td class="py-2 pr-3">₹<%= rates[:cod] %></td>
            <td class="py-2">₹<%= rates[:prepaid] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="mt-4 text-xs text-gray-500">
    Rates include Delhivery shipping, COD charge, GST, and TrustShip platform fee.
    UPI payment saves ₹<%= w[500][:cod] - w[500][:prepaid] %> per shipment.
  </p>
</section>

<div class="-mx-4 mt-6 flex gap-4 overflow-x-auto border-b border-gray-200 px-4 pb-0">
  <% order_status_tabs.each do |tab| %>
    <% active = orders_status_filter_active?(tab[:param]) %>
    <% path = tab[:param].present? ? orders_path(status: tab[:param]) : orders_path %>
    <%= link_to path,
          class: [
            "shrink-0 whitespace-nowrap border-b-2 pb-2 text-sm transition-colors",
            active ? "border-indigo-600 font-bold text-indigo-600" : "border-transparent font-medium text-gray-500 hover:text-gray-800"
          ].join(" ") do %>
      <%= tab[:label] %>
    <% end %>
  <% end %>
</div>

<div class="mt-6 space-y-4">
  <% if @orders.any? %>
    <% @orders.each do |order| %>
      <%= render "orders/order_card", order: order %>
    <% end %>
  <% else %>
    <div class="rounded-xl border border-dashed border-gray-200 bg-white py-16 text-center">
      <p class="text-lg font-medium text-gray-600">No orders yet</p>
      <%= link_to "Create your first order →", new_order_path, class: "mt-4 inline-block font-semibold text-indigo-600 hover:text-indigo-500" %>
    </div>
  <% end %>
</div>

<% if @pagy.pages > 1 %>
  <div class="mt-8 flex justify-center">
    <%== pagy_nav(@pagy) %>
  </div>
<% end %>
