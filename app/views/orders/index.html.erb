<% content_for :title, "Orders — TrustShip" %>
<% content_for :page_title, "Orders" %>
<% content_for :topbar_actions do %>
  <%= link_to new_order_path, class: "btn-primary", data: { turbo_frame: "new_order_modal" } do %>
    <i class="ti ti-plus text-sm"></i>
    New Order
  <% end %>
<% end %>

<div id="orders-index-page" data-controller="confirm-modal">
<div class="mb-5 grid grid-cols-2 gap-3 md:grid-cols-4">
  <div class="stat-card">
    <div class="stat-label">Total Orders</div>
    <div class="stat-value"><%= @total_orders %></div>
    <div class="stat-sub">Lifetime</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Pending</div>
    <div class="stat-value text-amber-600"><%= @pending_orders %></div>
    <div class="stat-sub">Awaiting gates</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Confirmed</div>
    <div class="stat-value text-green-700"><%= @confirmed_orders %></div>
    <div class="stat-sub">Ready to ship</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">RTO Rate</div>
    <div class="stat-value <%= @rto_rate > 10 ? 'text-red-600' : 'text-green-700' %>"><%= @rto_rate %>%</div>
    <div class="stat-sub"><%= @rto_rate < 10 ? "Excellent" : "Needs attention" %></div>
  </div>
</div>

<div class="overflow-hidden rounded-xl border border-gray-200 bg-white">
  <%= form_with url: orders_path, method: :get, local: true, data: { controller: "orders-list" }, class: "border-b border-gray-100 px-4 py-3" do %>
    <div class="flex flex-wrap items-center gap-3">
      <div class="flex min-w-[220px] flex-1 items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2">
        <i class="ti ti-search text-sm text-gray-400"></i>
        <%= text_field_tag :q, @query, placeholder: "Search buyer, product, phone...", class: "w-full border-none bg-transparent text-sm outline-none", data: { orders_list_target: "search", action: "input->orders-list#search" } %>
      </div>

      <%= select_tag :status, options_for_select([["All Statuses", "all"], ["Pending", "pending_verification"], ["Confirmed", "confirmed"], ["High Risk", "high_risk"], ["Shipped", "shipped"], ["Delivered", "delivered"], ["RTO", "rto"]], @status.presence || "all"), class: "rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700", data: { action: "change->orders-list#submit" } %>
      <%= select_tag :per_page, options_for_select([10, 25, 50, 100], @per_page), class: "rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700", data: { action: "change->orders-list#submit" } %>
      <%= hidden_field_tag :sort_by, @sort_by %>
      <%= hidden_field_tag :sort_dir, @sort_dir %>
    </div>
  <% end %>

  <% if @orders.any? %>
    <div class="overflow-x-auto" data-controller="orders-list">
      <table class="min-w-full divide-y divide-gray-100">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left"><%= orders_sort_link("Buyer", "buyer") %></th>
            <th class="px-4 py-3 text-left"><%= orders_sort_link("Product", "product") %></th>
            <th class="px-4 py-3 text-right"><%= orders_sort_link("Amount", "amount") %></th>
            <th class="px-4 py-3 text-left"><%= orders_sort_link("Status", "status") %></th>
            <th class="px-4 py-3 text-left"><%= orders_sort_link("Created", "created_at") %></th>
            <th class="px-4 py-3 text-right text-gray-600">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 bg-white">
          <% @orders.each do |order| %>
            <tr data-action="click->orders-list#go" data-url="<%= order_path(order) %>" class="cursor-pointer hover:bg-gray-50">
              <td class="px-4 py-3">
                <p class="text-sm font-semibold text-gray-900"><%= order.buyer&.name || "Unknown" %></p>
                <p class="text-xs text-gray-500"><%= order.buyer&.phone %></p>
              </td>
              <td class="px-4 py-3">
                <p class="text-sm text-gray-800"><%= order.product_name %></p>
                <p class="text-xs text-gray-500"><%= compact_location_text(order) %></p>
              </td>
              <td class="px-4 py-3 text-right">
                <p class="text-sm font-semibold text-gray-900">₹<%= number_with_precision(order.amount, precision: 2) %></p>
                <span class="inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold <%= order_payment_type_badge_classes(order) %>"><%= order.payment_type.humanize %></span>
              </td>
              <td class="px-4 py-3">
                <span class="inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold <%= status_badge_classes(order) %>"><%= order.aasm_state.humanize %></span>
              </td>
              <td class="px-4 py-3">
                <p class="text-sm text-gray-700"><%= time_ago_in_words(order.created_at) %> ago</p>
                <% risk = compact_risk_badge(order) %>
                <% if risk.present? %>
                  <span class="mt-1 inline-flex rounded-full px-2 py-0.5 text-[10px] font-semibold <%= risk[:classes] %>"><%= risk[:label] %></span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right" data-action="click->orders-list#stopRowNavigation">
                <details class="relative inline-block text-left" data-controller="details-dropdown">
                  <summary class="list-none cursor-pointer rounded-lg p-1.5 text-gray-500 hover:bg-gray-100 hover:text-gray-800 [&::-webkit-details-marker]:hidden" aria-label="Order actions">
                    <i class="ti ti-dots-vertical text-lg"></i>
                  </summary>
                  <div class="absolute right-0 z-20 mt-1 w-48 rounded-lg border border-gray-200 bg-white py-1 shadow-lg" data-action="click->orders-list#stopRowNavigation">
                    <% if order.editable_by_seller? %>
                      <%= link_to edit_order_path(order), class: "block px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-50", data: { turbo_frame: "_top", action: "click->orders-list#stopRowNavigation" } do %>
                        <i class="ti ti-pencil mr-2 text-base opacity-70"></i>Edit
                      <% end %>
                    <% end %>
                    <% if order.deletable_by_seller? %>
                      <button
                        type="button"
                        class="block w-full px-4 py-2 text-left text-sm text-red-700 hover:bg-red-50"
                        data-action="click->confirm-modal#openFromTrigger"
                        data-confirm-url="<%= order_path(order) %>"
                        data-confirm-method="delete"
                        data-confirm-title="Delete this order?"
                        data-confirm-message="This permanently removes the order and its history from your dashboard. This cannot be undone."
                        data-confirm-button-label="Delete order"
                      >
                        <i class="ti ti-trash mr-2 text-base opacity-70"></i>Delete
                      </button>
                    <% end %>
                    <% if !order.editable_by_seller? && !order.deletable_by_seller? %>
                      <span class="block px-4 py-2 text-left text-xs text-gray-400">No actions</span>
                    <% end %>
                  </div>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="border-t border-gray-100 px-4 py-3">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <div class="py-16 text-center">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-gray-400">
        <i class="ti ti-package text-2xl"></i>
      </div>
      <p class="mt-3 text-lg font-medium text-gray-700">No orders found</p>
      <p class="mt-1 text-sm text-gray-500">Try changing filters or search terms.</p>
    </div>
  <% end %>

  <div
    data-confirm-modal-target="shell"
    class="fixed inset-0 z-[60] hidden cursor-default items-center justify-center bg-gray-900/45 p-4 backdrop-blur-[1px]"
    data-action="click->confirm-modal#backdropClick"
    role="dialog"
    aria-modal="true"
    aria-labelledby="orders-index-confirm-title"
  >
    <div
      class="pointer-events-auto w-full max-w-md cursor-auto rounded-2xl border border-gray-200/90 bg-white p-6 shadow-2xl ring-1 ring-black/5"
      data-action="click->confirm-modal#stopPropagation"
    >
      <h3 id="orders-index-confirm-title" data-confirm-modal-target="title" class="text-lg font-semibold tracking-tight text-gray-900"></h3>
      <p data-confirm-modal-target="message" class="mt-2 text-sm leading-relaxed text-gray-600"></p>
      <div class="mt-6 flex flex-wrap justify-end gap-3">
        <button type="button" class="inline-flex cursor-pointer rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" data-action="click->confirm-modal#close">Cancel</button>
        <button type="button" data-confirm-modal-target="submitButton" class="inline-flex min-w-[7.5rem] cursor-pointer justify-center rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" data-action="click->confirm-modal#confirmSubmit">Delete</button>
      </div>
    </div>
  </div>

  <form method="post" action="#" data-confirm-modal-target="form" data-turbo="true" class="hidden" aria-hidden="true">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <input type="hidden" name="_method" value="delete" disabled autocomplete="off" data-confirm-modal-delete-field />
  </form>
</div>
</div>

<%= turbo_frame_tag "new_order_modal" %>
