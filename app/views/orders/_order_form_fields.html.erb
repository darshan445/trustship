<%# locals: (f:, parsed: false, autofilled: {}) %>
<% manual_input = "mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
<% missing_ph = "Not found — please fill in" %>

<div>
  <%= f.label :buyer_name, "Buyer Name", class: "mb-1 block text-sm font-medium text-gray-700" %>
  <%= f.text_field :buyer_name,
        class: parsed ? order_parse_input_classes(autofilled, :buyer_name) : manual_input,
        placeholder: (parsed && !autofilled["buyer_name"]) ? missing_ph : nil %>
  <% f.object.errors[:buyer_name].each do |msg| %>
    <p class="mt-1 text-sm text-red-600"><%= msg %></p>
  <% end %>
</div>

<div>
  <%= f.label :buyer_phone, "Buyer Phone", class: "mb-1 block text-sm font-medium text-gray-700" %>
  <%= f.telephone_field :buyer_phone,
        placeholder: (parsed && !autofilled["buyer_phone"]) ? missing_ph : "10-digit mobile number",
        class: parsed ? order_parse_input_classes(autofilled, :buyer_phone) : manual_input %>
  <% f.object.errors[:buyer_phone].each do |msg| %>
    <p class="mt-1 text-sm text-red-600"><%= msg %></p>
  <% end %>
</div>

<div>
  <%= f.label :product_name, "Product Name", class: "mb-1 block text-sm font-medium text-gray-700" %>
  <%= f.text_field :product_name,
        class: parsed ? order_parse_input_classes(autofilled, :product_name) : manual_input,
        placeholder: (parsed && !autofilled["product_name"]) ? missing_ph : nil %>
  <%= f.hidden_field :product_id %>
  <% if parsed && f.object.product_id.present? %>
    <p class="mt-1 text-xs text-green-700">Matched to catalog product.</p>
  <% end %>
  <% f.object.errors[:product_name].each do |msg| %>
    <p class="mt-1 text-sm text-red-600"><%= msg %></p>
  <% end %>
</div>

<div>
  <%= f.label :amount, "Amount (₹)", class: "mb-1 block text-sm font-medium text-gray-700" %>
  <%= f.number_field :amount,
        step: "0.01",
        min: 0,
        placeholder: (parsed && !autofilled["amount"]) ? missing_ph : "Enter amount in ₹",
        class: parsed ? order_parse_input_classes(autofilled, :amount) : manual_input %>
  <% f.object.errors[:amount].each do |msg| %>
    <p class="mt-1 text-sm text-red-600"><%= msg %></p>
  <% end %>
</div>

<div>
  <%= f.label :raw_address, "Delivery Address", class: "mb-1 block text-sm font-medium text-gray-700" %>
  <%= f.text_area :raw_address,
        rows: 3,
        class: parsed ? order_parse_input_classes(autofilled, :raw_address) : manual_input,
        placeholder: (parsed && !autofilled["raw_address"]) ? missing_ph : "Enter full delivery address" %>
  <% f.object.errors[:raw_address].each do |msg| %>
    <p class="mt-1 text-sm text-red-600"><%= msg %></p>
  <% end %>
</div>

<div>
  <%= f.label :payment_type, "Expected payment at delivery", class: "mb-1 block text-sm font-medium text-gray-700" %>
  <%= f.select :payment_type,
        [ [ "Cash on delivery", "full_cod" ], [ "Prepaid / already paid online", "full_prepaid" ] ],
        {},
        class: parsed ? order_parse_input_classes(autofilled, :payment_type) : manual_input %>
  <% if parsed %>
    <p class="mt-1 text-xs text-gray-500">Auto-detected from parsed message. You can change it before creating the order.</p>
  <% end %>
  <% f.object.errors[:payment_type].each do |msg| %>
    <p class="mt-1 text-sm text-red-600"><%= msg %></p>
  <% end %>
</div>

<% unless parsed %>
  <div>
    <%= f.label :raw_message, "Raw WhatsApp Message", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_area :raw_message, rows: 4, placeholder: "Paste original WhatsApp message here if available", class: manual_input %>
  </div>
<% end %>

<div>
  <%= f.label :seller_note, "Seller Note", class: "mb-1 block text-sm font-medium text-gray-700" %>
  <%= f.text_area :seller_note, rows: 3, class: manual_input %>
  <% f.object.errors[:seller_note].each do |msg| %>
    <p class="mt-1 text-sm text-red-600"><%= msg %></p>
  <% end %>
</div>
