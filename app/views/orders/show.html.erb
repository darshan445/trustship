<% content_for :title, "#{@order.product_name} — TrustShip" %>

<p class="mb-4">
  <%= link_to "← Back to Orders", orders_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
</p>

<div class="space-y-6">
  <% if @order.amount.to_d.zero? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-900">
      ⚠️ Order amount is ₹0 — please verify with buyer before shipping
    </div>
  <% end %>

  <%= render "orders/green_zone_banner", order: @order %>

  <section class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0 space-y-2">
        <div class="flex flex-wrap items-baseline gap-2">
          <span class="text-lg font-semibold text-gray-900"><%= @order.buyer.name %></span>
          <span class="text-sm text-gray-600"><%= @order.buyer.phone %></span>
        </div>
        <p class="text-gray-900">
          <span class="font-semibold"><%= @order.product_name %></span>
          <span class="text-gray-600">·</span>
          <span class="font-medium">₹<%= number_with_precision(@order.amount, precision: 2) %></span>
          <% if @order.full_prepaid? %>
            <span class="ml-2 font-semibold text-green-700">Prepaid</span>
          <% elsif @order.partial_cod? %>
            <span class="ml-2 font-semibold text-amber-800">Partial COD</span>
          <% else %>
            <span class="ml-2 text-gray-600">COD</span>
          <% end %>
        </p>
        <p class="text-sm text-gray-500">Created <%= @order.created_at.strftime("%b %d, %Y at %I:%M %p") %></p>
      </div>
      <span class="inline-flex shrink-0 self-start rounded-full px-3 py-1.5 text-sm font-bold <%= status_badge_classes(@order) %>">
        <%= @order.aasm_state.humanize %>
      </span>
    </div>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-gray-900">Details</h2>
    <dl class="mt-4 space-y-2 text-sm">
      <div>
        <dt class="font-medium text-gray-500">Address</dt>
        <dd class="mt-0.5 text-gray-900"><%= @order.address_line %>, <%= @order.city %>, <%= @order.state %> <%= @order.pincode %></dd>
      </div>
      <% if @order.seller_note.present? %>
        <div>
          <dt class="font-medium text-gray-500">Seller note</dt>
          <dd class="mt-0.5 whitespace-pre-wrap text-gray-900"><%= @order.seller_note %></dd>
        </div>
      <% end %>
      <% if @order.raw_message.present? %>
        <div class="pt-2" data-controller="original-message">
          <button
            type="button"
            data-action="click->original-message#toggle"
            data-original-message-target="trigger"
            class="text-sm font-semibold text-indigo-600 hover:text-indigo-500">
            <span data-original-message-target="labelOpen">View original message</span>
            <span data-original-message-target="labelClose" class="hidden">Hide original message</span>
            <span data-original-message-target="iconOpen" aria-hidden="true">▾</span>
            <span data-original-message-target="iconClose" class="hidden" aria-hidden="true">▴</span>
          </button>
          <div data-original-message-target="panel" class="mt-2 hidden rounded-lg border border-gray-200 bg-gray-50 p-3">
            <pre class="whitespace-pre-wrap break-words font-mono text-xs text-gray-800"><%= @order.raw_message %></pre>
          </div>
        </div>
      <% end %>
    </dl>
  </section>

  <%= render "orders/verification_gates", order: @order %>

  <% if @order.shipped? || @order.delivered? || @order.rto? %>
    <section class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-gray-900">Shipment Details</h2>
      <dl class="mt-4 space-y-3 text-sm">
        <div class="flex flex-wrap items-center gap-2">
          <dt class="font-medium text-gray-500">AWB</dt>
          <dd class="font-mono text-gray-900"><%= @order.awb_number %></dd>
          <div class="flex flex-wrap items-center gap-2" data-controller="clipboard" data-clipboard-text-value="<%= @order.awb_number %>">
            <button
              type="button"
              data-action="click->clipboard#copy"
              class="rounded border border-gray-300 bg-white px-2 py-1 text-xs font-medium text-gray-700 hover:bg-gray-50">
              Copy
            </button>
            <span data-clipboard-target="feedback" class="text-xs font-medium text-green-700" aria-live="polite"></span>
          </div>
        </div>
        <% if @order.shipped_at.present? %>
          <div>
            <dt class="font-medium text-gray-500">Shipped at</dt>
            <dd class="mt-0.5 text-gray-900"><%= @order.shipped_at.strftime("%d %b %Y, %H:%M") %></dd>
          </div>
        <% end %>
      </dl>
      <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
        <% if @order.shipping_label.attached? %>
          <%= link_to "Download Shipping Label",
                rails_blob_path(@order.shipping_label, disposition: :attachment),
                class: "inline-flex items-center justify-center rounded-lg border-2 border-indigo-600 bg-white px-4 py-2.5 text-sm font-semibold text-indigo-700 shadow-sm hover:bg-indigo-50" %>
        <% elsif @order.awb_number.present? %>
          <%= button_to "Label not available — Fetch Again",
                fetch_label_order_path(@order),
                method: :post,
                form: { class: "inline-block" },
                class: "inline-flex cursor-pointer items-center justify-center rounded-lg border-2 border-amber-600 bg-white px-4 py-2.5 text-sm font-semibold text-amber-800 shadow-sm hover:bg-amber-50" %>
        <% end %>
        <%= link_to "Track on Delhivery →",
              "https://www.delhivery.com/track/package/#{@order.awb_number}",
              target: "_blank",
              rel: "noopener noreferrer",
              class: "inline-flex items-center justify-center text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>
      </div>
    </section>

    <section class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-gray-900">Live Tracking</h2>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span class="inline-flex rounded-full px-4 py-1.5 text-sm font-bold <%= live_tracking_status_badge_classes(@order) %>">
          <%= @order.aasm_state.humanize %>
        </span>
        <% if @latest_order_event.present? %>
          <span class="text-sm text-gray-600">
            Last updated: <%= @latest_order_event.created_at.strftime("%d %b %Y, %H:%M") %>
          </span>
        <% end %>
      </div>

      <% if @order.delivered? && @order.delivered_at.present? %>
        <div class="mt-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-900">
          Delivered on <%= @order.delivered_at.strftime("%d %b %Y, %H:%M") %>
        </div>
      <% elsif @order.rto? %>
        <div class="mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900">
          <p class="font-semibold">Returning to seller</p>
          <% if @order.rto_at.present? %>
            <p class="mt-1 text-xs text-red-800/90">RTO recorded at <%= @order.rto_at.strftime("%d %b %Y, %H:%M") %></p>
          <% end %>
        </div>
      <% elsif @order.shipped? && @ofd_event.present? %>
        <% meta = @ofd_event.metadata || {} %>
        <% oname = meta["agent_name"].presence %>
        <% ophone = meta["agent_phone"].presence %>
        <% if oname || ophone %>
          <p class="mt-4 text-sm font-semibold text-gray-900">
            Your delivery agent:
            <%= [ oname, ophone ].compact.join(" · ") %>
          </p>
        <% end %>
      <% end %>

      <% if @order.awb_number.present? %>
        <p class="mt-4">
          <%= link_to "Track on Delhivery →",
                "https://www.delhivery.com/track/package/#{@order.awb_number}",
                target: "_blank",
                rel: "noopener noreferrer",
                class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>
        </p>
      <% end %>
    </section>
  <% end %>

  <section class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-gray-900">Buyer risk</h2>
    <div class="mt-4 space-y-2 text-sm text-gray-700">
      <p>
        <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= risk_badge_classes(@buyer.risk_level) %>">
          <%= @buyer.risk_level.humanize %>
        </span>
      </p>
      <p><span class="font-medium text-gray-900"><%= @buyer.rto_count %></span> previous RTOs</p>
      <p><span class="font-medium text-gray-900"><%= @buyer.successful_delivery_count %></span> successful deliveries</p>
      <p>Repeat buyer: <span class="font-medium text-gray-900"><%= @buyer.repeat_buyer? ? "Yes" : "No" %></span></p>
    </div>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-gray-900">Order History</h2>
    <% if @order_events.any? %>
      <div class="mt-6">
        <%= render "orders/timeline", order_events: @order_events %>
      </div>
    <% else %>
      <p class="mt-4 text-sm text-gray-600">No state changes recorded yet.</p>
    <% end %>
  </section>
</div>
