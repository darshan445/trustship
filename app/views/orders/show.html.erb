<% content_for :title, "#{@order.product_name} — TrustShip" %>

<p class="mb-4">
  <%= link_to "← Back to Orders", orders_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
</p>

<div class="space-y-6">
  <% if @order.amount.to_d.zero? %>
    <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-900">
      ⚠️ Order amount is ₹0 — please verify with buyer before shipping
    </div>
  <% end %>

  <section class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0 space-y-2">
        <div class="flex flex-wrap items-baseline gap-2">
          <span class="text-lg font-semibold text-gray-900"><%= @order.buyer.name %></span>
          <span class="text-sm text-gray-600"><%= @order.buyer.phone %></span>
        </div>
        <p class="text-gray-900">
          <span class="font-semibold"><%= @order.product_name %></span>
          <span class="text-gray-600">·</span>
          <span class="font-medium">₹<%= number_with_precision(@order.amount, precision: 2) %></span>
          <% if @order.full_prepaid? %>
            <span class="ml-2 font-semibold text-green-700">UPI payment</span>
          <% elsif @order.partial_cod? %>
            <span class="ml-2 font-semibold text-amber-800">Partial COD</span>
          <% else %>
            <span class="ml-2 text-gray-600">COD</span>
          <% end %>
        </p>
        <p class="text-sm text-gray-500">Created <%= @order.created_at.strftime("%b %d, %Y at %I:%M %p") %></p>
      </div>
      <span class="inline-flex shrink-0 self-start rounded-full px-3 py-1.5 text-sm font-bold <%= status_badge_classes(@order) %>">
        <%= @order.aasm_state.humanize %>
      </span>
    </div>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-gray-900">Details</h2>
    <dl class="mt-4 space-y-2 text-sm">
      <div>
        <dt class="font-medium text-gray-500">Product Link</dt>
        <% if @order.product_id.present? %>
          <dd class="mt-1 text-gray-900">✅ <%= @order.product&.name || @order.product_name %> (linked)</dd>
        <% elsif @active_products.any? %>
          <dd class="mt-1 text-gray-900">⚠️ <%= @order.product_name %> (unlinked)</dd>
          <div class="mt-2" data-controller="product-link" data-product-link-order-id-value="<%= @order.id %>">
            <%= select_tag :product_id,
                  options_from_collection_for_select(@active_products, :id, :name),
                  prompt: "Link to a product...",
                  class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900",
                  data: { action: "change->product-link#save", product_link_target: "select" } %>
            <p class="mt-1 text-xs text-gray-500" data-product-link-target="message"></p>
          </div>
        <% else %>
          <dd class="mt-1 text-gray-900"><%= @order.product_name %></dd>
        <% end %>
      </div>
      <% display_address = @order.buyer_address&.address_formatted.presence || @order.buyer_address&.raw_address.presence || "Address pending" %>
      <div>
        <dt class="font-medium text-gray-500">Address</dt>
        <dd class="mt-0.5 text-gray-900"><%= display_address %></dd>
      </div>
      <% if @order.seller_note.present? %>
        <div>
          <dt class="font-medium text-gray-500">Seller note</dt>
          <dd class="mt-0.5 whitespace-pre-wrap text-gray-900"><%= @order.seller_note %></dd>
        </div>
      <% end %>
      <% if @order.raw_message.present? %>
        <div class="pt-2" data-controller="original-message">
          <button
            type="button"
            data-action="click->original-message#toggle"
            data-original-message-target="trigger"
            class="text-sm font-semibold text-indigo-600 hover:text-indigo-500">
            <span data-original-message-target="labelOpen">View original message</span>
            <span data-original-message-target="labelClose" class="hidden">Hide original message</span>
            <span data-original-message-target="iconOpen" aria-hidden="true">▾</span>
            <span data-original-message-target="iconClose" class="hidden" aria-hidden="true">▴</span>
          </button>
          <div data-original-message-target="panel" class="mt-2 hidden rounded-lg border border-gray-200 bg-gray-50 p-3">
            <pre class="whitespace-pre-wrap break-words font-mono text-xs text-gray-800"><%= @order.raw_message %></pre>
          </div>
        </div>
      <% end %>
    </dl>
  </section>

  <%= render "orders/verification_gates", order: @order %>

  <%# Shipment detail cards removed from order fields cleanup %>

  <section class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-gray-900">Buyer risk</h2>
    <div class="mt-4 space-y-2 text-sm text-gray-700">
      <p>
        <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= risk_badge_classes(@buyer.risk_level) %>">
          <%= @buyer.risk_level.humanize %>
        </span>
      </p>
      <p><span class="font-medium text-gray-900"><%= @buyer.rto_count %></span> previous RTOs</p>
      <p><span class="font-medium text-gray-900"><%= @buyer.successful_delivery_count %></span> successful deliveries</p>
      <p>Repeat buyer: <span class="font-medium text-gray-900"><%= @buyer.repeat_buyer? ? "Yes" : "No" %></span></p>
    </div>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-bold text-gray-900">Order History</h2>
    <% if @order_events.any? %>
      <div class="mt-6">
        <%= render "orders/timeline", order_events: @order_events %>
      </div>
    <% else %>
      <p class="mt-4 text-sm text-gray-600">No state changes recorded yet.</p>
    <% end %>
  </section>
</div>
