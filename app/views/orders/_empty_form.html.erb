<%# locals: (order:) %>
<%= form_with model: order, url: orders_path, class: "space-y-5" do |f| %>
  <%= render "order_form_fields", f: f, parsed: false, autofilled: {} %>
  <%= f.submit "Create Order →", class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
<% end %>
