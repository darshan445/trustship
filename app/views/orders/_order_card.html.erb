<%= link_to order_path(order), class: "block rounded-xl border border-gray-100 bg-white p-4 shadow-sm transition-shadow hover:shadow-md" do %>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1 space-y-2">
      <div class="flex flex-wrap items-baseline gap-2">
        <span class="font-semibold text-gray-900"><%= order.buyer.name %></span>
        <span class="text-sm text-gray-600"><%= order.buyer.phone %></span>
        <% if order.raw_message.present? %>
          <span class="rounded-full bg-green-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-green-800">WhatsApp</span>
        <% else %>
          <span class="rounded-full bg-gray-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-gray-600">Manual</span>
        <% end %>
      </div>
      <p class="font-medium text-gray-900"><%= order.product_name %></p>
      <p class="text-sm text-gray-600">
        <span class="font-medium text-gray-800">₹<%= number_with_precision(order.amount, precision: 2) %></span>
        <% if order.full_prepaid? %>
          <span class="ml-2 font-medium text-green-700">Prepaid</span>
        <% elsif order.partial_cod? %>
          <span class="ml-2 font-medium text-amber-800">Partial COD</span>
        <% else %>
          <span class="ml-2 text-gray-600">COD</span>
        <% end %>
      </p>
      <p class="text-sm text-gray-600"><%= order.city %>, <%= order.state %> <%= order.pincode %></p>
      <p class="text-xs text-gray-500"><%= time_ago_in_words(order.created_at) %> ago</p>
    </div>
    <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold <%= status_badge_classes(order) %>">
      <%= order.aasm_state.humanize %>
    </span>
  </div>
<% end %>
