<% content_for :title, "New Order — TrustShip" %>

<div class="mx-auto max-w-lg space-y-6 pb-8">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">New Order</h1>
    <p class="mt-1 text-sm font-medium text-gray-600">Paste a WhatsApp message to auto-fill the order details</p>
  </div>

  <%= form_with url: parse_orders_path, method: :post,
        data: { controller: "parse", turbo_frame: "order_form" },
        class: "space-y-3" do %>
    <%= label_tag :raw_message, "WhatsApp Message", class: "block text-sm font-medium text-gray-700" %>
    <%= text_area_tag :raw_message, nil,
          rows: 6,
          placeholder: "Paste the buyer's WhatsApp message here…\nExample: bhai ek blue earring chahiye, ghar pe dena, surat gujarat 395009, COD hai kya? mera naam raj hai 9876543210",
          class: "block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    <%= button_tag type: "submit",
          data: { parse_target: "button" },
          class: "flex w-full cursor-pointer items-center justify-center gap-2 rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-70" do %>
      <svg class="h-5 w-5 shrink-0 text-indigo-100" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.847a4.5 4.5 0 003.09 3.09L15.75 12l-2.847.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
      </svg>
      <span>Parse Order</span>
    <% end %>
  <% end %>

  <p class="text-center text-sm">
    <%= link_to "or fill the form manually →", manual_orders_path, class: "font-medium text-indigo-600 hover:text-indigo-500", data: { turbo_frame: "order_form" } %>
  </p>

  <div id="order-form-anchor" class="scroll-mt-4">
    <%= turbo_frame_tag "order_form" do %>
      <%= render "empty_form", order: @order %>
    <% end %>
  </div>

  <p class="text-center">
    <%= link_to "← Back to Orders", orders_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
  </p>
</div>
