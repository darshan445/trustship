<%# locals: (order:) %>
<% buyer = order.buyer %>
<% address = order.buyer_address %>
<% gate1_done = address&.validated_at.present? %>
<% gate2_done = order.order_events.where(event_name: ["mark_high_risk", "gate_2_completed"]).exists? %>
<% first_time = buyer.rto_count.zero? && buyer.successful_delivery_count.zero? %>
<% gate1_event = order.order_events.where(event_name: "gate_1_completed").order(created_at: :desc).first %>
<% reused_address = gate1_event&.metadata.to_h["reused"] == true %>

<%# Flash inside the turbo frame so actions show feedback without a full layout reload %>
<% if flash[:notice].present? %>
  <div class="mb-4 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800" data-controller="flash" role="status"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert].present? %>
  <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" data-controller="flash" role="alert"><%= flash[:alert] %></div>
<% end %>

<section class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm" aria-labelledby="verification-gates-heading">
  <h2 id="verification-gates-heading" class="text-lg font-bold text-gray-900">Verification Gates</h2>

  <div class="mt-4 rounded-lg border border-gray-100 bg-gray-50/80 p-4">
    <h3 class="text-sm font-semibold text-gray-800">Gate 1 — Address Validation</h3>
    <% if address.nil? %>
      <div class="mt-2 flex items-start gap-2 text-sm text-gray-600">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd" />
        </svg>
        <span>Address validation pending</span>
      </div>
    <% elsif address.address_confidence == "high" %>
      <div class="mt-2 space-y-2 text-sm text-green-800">
        <div class="flex items-start gap-2">
          <span class="mt-0.5 shrink-0" aria-hidden="true">✅</span>
          <div>
            <span class="font-medium">Address Verified</span>
            <% if address.address_formatted.present? %>
              <p class="mt-1 rounded-md border border-green-200 bg-white/80 px-2 py-1.5 text-xs leading-snug text-green-950"><%= address.address_formatted %></p>
            <% end %>
            <p class="mt-1 text-xs text-green-900/90">Exact location confirmed</p>
            <% if reused_address %>
              <span class="mt-2 inline-flex rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold text-emerald-800">Previously verified address</span>
            <% end %>
          </div>
        </div>
      </div>
    <% elsif address.address_confidence == "medium" %>
      <div class="mt-2 space-y-2 text-sm text-amber-900">
        <div class="flex items-start gap-2">
          <span class="mt-0.5 shrink-0" aria-hidden="true">🟡</span>
          <div>
            <span class="font-medium">Address Approximate</span>
            <% if address.address_formatted.present? %>
              <p class="mt-1 rounded-md border border-amber-200 bg-white/80 px-2 py-1.5 text-xs leading-snug text-amber-950"><%= address.address_formatted %></p>
            <% end %>
            <p class="mt-2 text-xs text-amber-800/90">Approximate location found. Buyer will confirm in next step.</p>
            <% if reused_address %>
              <span class="mt-2 inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-800">Previously verified address</span>
            <% end %>
          </div>
        </div>
      </div>
    <% elsif address.address_confidence == "low" %>
      <div class="mt-2 space-y-2 text-sm text-orange-900">
        <div class="flex items-start gap-2">
          <span class="mt-0.5 shrink-0" aria-hidden="true">🟠</span>
          <div>
            <span class="font-medium">Address Unclear</span>
            <% if address.address_formatted.present? %>
              <p class="mt-1 rounded-md border border-orange-200 bg-white/80 px-2 py-1.5 text-xs leading-snug text-orange-950"><%= address.address_formatted %></p>
            <% end %>
            <p class="mt-2 text-xs text-orange-900/90">Vague address. Watch buyer confirmation carefully.</p>
          </div>
        </div>
      </div>
    <% elsif address.address_confidence == "failed" %>
      <div class="mt-2 space-y-2 text-sm text-red-900">
        <div class="flex items-start gap-2">
          <span class="mt-0.5 shrink-0" aria-hidden="true">🔴</span>
          <div>
            <span class="font-medium">Address Not Found</span>
            <p class="mt-2 text-xs text-red-900/90">Could not locate on maps. Consider contacting buyer.</p>
          </div>
        </div>
      </div>
    <% elsif address.address_confidence == "unknown" %>
      <div class="mt-2 space-y-2 text-sm text-gray-700">
        <div class="flex items-start gap-2">
          <span class="mt-0.5 shrink-0" aria-hidden="true">⚪</span>
          <div>
            <span class="font-medium">Validation Unavailable</span>
            <p class="mt-2 text-xs text-gray-600">Validation service unavailable. Proceeding without confirmation.</p>
          </div>
        </div>
      </div>
    <% else %>
      <div class="mt-2 space-y-2 text-sm text-gray-700">
        <div class="flex items-start gap-2">
          <span class="mt-0.5 shrink-0" aria-hidden="true">⏳</span>
          <div>
            <span class="font-medium">Validation Pending</span>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-4 rounded-lg border border-gray-100 bg-gray-50/80 p-4">
    <h3 class="text-sm font-semibold text-gray-800">Gate 2 — Risk Scoring</h3>

    <% if order.undeliverable? %>
      <p class="mt-2 text-sm text-gray-600">Skipped — order marked undeliverable at Gate 1.</p>
    <% elsif order.high_risk? %>
      <div class="mt-2 flex items-start gap-2 text-sm text-orange-900">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-orange-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
        </svg>
        <span class="font-medium">High risk buyer — <%= buyer.rto_count %> previous RTOs</span>
      </div>
      <%# Break out of the order_checklist turbo frame so the full order page refreshes and the status badge updates %>
      <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:gap-3">
        <%= button_to "Ship Anyway",
              override_risk_order_path(order),
              method: :post,
              data: { turbo_confirm: "This buyer is flagged as high risk. Ship anyway?" },
              form: { class: "inline-block w-full sm:w-auto", data: { turbo_frame: "_top" } },
              class: "w-full cursor-pointer rounded-lg border-2 border-orange-500 bg-white px-4 py-2.5 text-sm font-semibold text-orange-700 shadow-sm hover:bg-orange-50 sm:w-auto" %>
        <%= button_to "Cancel Order",
              cancel_order_order_path(order),
              method: :post,
              data: { turbo_confirm: "Cancel this order? This cannot be undone from here." },
              form: { class: "inline-block w-full sm:w-auto", data: { turbo_frame: "_top" } },
              class: "w-full cursor-pointer rounded-lg border-2 border-red-600 bg-white px-4 py-2.5 text-sm font-semibold text-red-700 shadow-sm hover:bg-red-50 sm:w-auto" %>
      </div>
    <% elsif !gate1_done %>
      <div class="mt-2 flex items-start gap-2 text-sm text-gray-600">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd" />
        </svg>
        <span>Waiting for Gate 1 to complete…</span>
      </div>
    <% elsif order.pending_verification? && gate1_done && !gate2_done %>
      <div class="mt-2 flex items-start gap-2 text-sm text-amber-900">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-amber-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd" />
        </svg>
        <span>Checking buyer history...</span>
      </div>
    <% elsif gate2_done && buyer.low? %>
      <div class="mt-2 flex items-start gap-2 text-sm text-green-800">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-green-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
        </svg>
        <span>Low risk buyer — no previous RTOs</span>
      </div>
    <% elsif gate2_done && buyer.medium? %>
      <div class="mt-2 flex items-start gap-2 text-sm text-amber-900">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-amber-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
        </svg>
        <span>Medium risk — proceed with caution</span>
      </div>
    <% elsif gate2_done && buyer.high? %>
      <div class="mt-2 flex items-start gap-2 text-sm text-orange-900">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-orange-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
        </svg>
        <span>High risk buyer — <%= buyer.rto_count %> previous RTOs<% if !order.high_risk? %> (seller approved or continued)<% end %></span>
      </div>
    <% else %>
      <p class="mt-2 text-sm text-gray-600">Risk assessment pending.</p>
    <% end %>

    <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-gray-600">
      <span><%= buyer.rto_count %> previous RTOs · <%= buyer.successful_delivery_count %> successful deliveries</span>
      <% if first_time %>
        <span class="rounded-full bg-blue-100 px-2 py-0.5 font-semibold text-blue-800">First time buyer</span>
      <% end %>
    </div>
  </div>

  <% confirmation = order.order_confirmation %>
  <% last_confirm = order.order_events.where(event_name: "confirm").order(created_at: :desc).first %>
  <div class="mt-4 rounded-lg border border-gray-100 bg-gray-50/80 p-4">
    <h3 class="text-sm font-semibold text-gray-800">Gate 3 — WhatsApp Confirmation</h3>

    <% if confirmation.nil? %>
      <div class="mt-2 flex items-start gap-2 text-sm text-gray-600">
        <span class="mt-0.5 shrink-0" aria-hidden="true">⏳</span>
        <span>Confirmation not sent yet</span>
      </div>
    <% elsif confirmation.response == "confirmed" %>
      <div class="mt-2 flex items-start gap-2 text-sm text-green-800">
        <span class="mt-0.5 shrink-0" aria-hidden="true">✅</span>
        <div>
          <span class="font-medium">Buyer Confirmed</span>
          <% if confirmation.responded_at.present? %>
            <p class="mt-1 text-xs text-green-900/90">Confirmed <%= time_ago_in_words(confirmation.responded_at) %> ago</p>
          <% end %>
        </div>
      </div>
    <% elsif confirmation.response == "cancelled" %>
      <div class="mt-2 flex items-start gap-2 text-sm text-red-800">
        <span class="mt-0.5 shrink-0" aria-hidden="true">❌</span>
        <span class="font-medium">Buyer Cancelled</span>
      </div>
    <% elsif confirmation.response == "address_correction" %>
      <div class="mt-2 flex items-start gap-2 text-sm text-blue-800">
        <span class="mt-0.5 shrink-0" aria-hidden="true">📍</span>
        <div>
          <span class="font-medium">Buyer Corrected Address</span>
          <% if confirmation.corrected_address.present? %>
            <p class="mt-1 text-xs text-blue-900/90"><%= confirmation.corrected_address %></p>
          <% end %>
          <p class="mt-1 text-xs text-blue-900/90">New address validated. Confirmation resent.</p>
        </div>
      </div>
    <% elsif confirmation.seller_notified_at.present? && confirmation.responded_at.nil? %>
      <div class="mt-2 flex items-start gap-2 text-sm text-red-800">
        <span class="mt-0.5 shrink-0" aria-hidden="true">⚠️</span>
        <div>
          <span class="font-medium">No response from buyer</span>
          <p class="mt-1 text-xs text-red-900/90">Seller notified. Awaiting your decision.</p>
          <div class="mt-3 flex flex-col gap-2 sm:flex-row">
            <%= button_to "Keep Waiting", override_risk_order_path(order), method: :post, params: { decision: "keep_waiting" }, form: { data: { turbo_frame: "_top" } }, class: "rounded-lg border border-blue-300 bg-white px-3 py-2 text-xs font-semibold text-blue-700 hover:bg-blue-50" %>
            <%= button_to "Cancel Order", override_risk_order_path(order), method: :post, params: { decision: "cancelled" }, form: { data: { turbo_frame: "_top" } }, class: "rounded-lg border border-red-300 bg-white px-3 py-2 text-xs font-semibold text-red-700 hover:bg-red-50" %>
          </div>
        </div>
      </div>
    <% elsif confirmation.reminded_at.present? && confirmation.responded_at.nil? %>
      <div class="mt-2 flex items-start gap-2 text-sm text-amber-900">
        <span class="mt-0.5 shrink-0" aria-hidden="true">🕐</span>
        <div>
          <span class="font-medium">Reminder sent — awaiting response</span>
          <p class="mt-1 text-xs text-amber-900/90">Reminded <%= time_ago_in_words(confirmation.reminded_at) %> ago</p>
        </div>
      </div>
    <% elsif confirmation.sent_at.present? && confirmation.responded_at.nil? %>
      <div class="mt-2 flex items-start gap-2 text-sm text-blue-900">
        <span class="mt-0.5 shrink-0" aria-hidden="true">🕐</span>
        <div>
          <span class="font-medium">Waiting for buyer confirmation</span>
          <p class="mt-1 text-xs text-blue-900/90">Sent <%= time_ago_in_words(confirmation.sent_at) %> ago</p>
          <p class="mt-1 text-xs text-blue-900/90">Reminder sends in 4 hours if no response</p>
        </div>
      </div>
    <% else %>
      <div class="mt-2 flex items-start gap-2 text-sm text-gray-600">
        <span class="mt-0.5 shrink-0" aria-hidden="true">⏳</span>
        <span>Waiting to start</span>
      </div>
    <% end %>
  </div>

  <% advance = order.order_advance_payment %>
  <% gate4_skipped = order.order_events.where(event_name: "gate_4_skipped").order(created_at: :desc).first %>
  <div class="mt-4 rounded-lg border border-gray-100 bg-gray-50/80 p-4">
    <h3 class="text-sm font-semibold text-gray-800">Gate 4 — COD Advance</h3>

    <% if gate4_skipped&.metadata.to_h["reason"] == "prepaid_order" %>
      <div class="mt-2 flex items-start gap-2 text-sm text-green-800">
        <span class="mt-0.5 shrink-0" aria-hidden="true">✅</span>
        <div>
          <span class="font-medium">Gate 4 Skipped</span>
          <p class="mt-1 text-xs text-green-900/90">Prepaid order — no advance needed</p>
        </div>
      </div>
    <% elsif gate4_skipped&.metadata.to_h["reason"] == "no_advance_configured_for_product" %>
      <div class="mt-2 flex items-start gap-2 text-sm text-gray-700">
        <span class="mt-0.5 shrink-0" aria-hidden="true">⚪</span>
        <div>
          <span class="font-medium">Gate 4 Not Configured</span>
          <p class="mt-1 text-xs text-gray-600">This product has COD advance set to ₹0</p>
        </div>
      </div>
    <% elsif advance.nil? %>
      <div class="mt-2 flex items-start gap-2 text-sm text-gray-600">
        <span class="mt-0.5 shrink-0" aria-hidden="true">⏳</span>
        <span>Advance payment pending</span>
      </div>
    <% elsif advance.paid? %>
      <div class="mt-2 flex items-start gap-2 text-sm text-green-800">
        <span class="mt-0.5 shrink-0" aria-hidden="true">✅</span>
        <div>
          <span class="font-medium">Advance Paid</span>
          <p class="mt-1 text-xs text-green-900/90">₹<%= number_with_precision(advance.amount, precision: 2) %> received</p>
          <p class="mt-1 text-xs text-green-900/90"><%= time_ago_in_words(advance.paid_at) %> ago</p>
        </div>
      </div>
    <% elsif advance.seller_notified_at.present? %>
      <div class="mt-2 flex items-start gap-2 text-sm text-red-800">
        <span class="mt-0.5 shrink-0" aria-hidden="true">⚠️</span>
        <div>
          <span class="font-medium">Buyer Has Not Paid Advance</span>
          <p class="mt-1 text-xs text-red-900/90">₹<%= number_with_precision(advance.amount, precision: 2) %> unpaid after 8 hours</p>
          <div class="mt-3 flex flex-col gap-2 sm:flex-row">
            <%= button_to "Keep Waiting", override_risk_order_path(order), method: :post, params: { decision: "keep_waiting" }, form: { data: { turbo_frame: "_top" } }, class: "rounded-lg border border-blue-300 bg-white px-3 py-2 text-xs font-semibold text-blue-700 hover:bg-blue-50" %>
            <%= button_to "Cancel Order", override_risk_order_path(order), method: :post, params: { decision: "cancelled" }, form: { data: { turbo_frame: "_top" } }, class: "rounded-lg border border-red-300 bg-white px-3 py-2 text-xs font-semibold text-red-700 hover:bg-red-50" %>
          </div>
        </div>
      </div>
    <% elsif advance.reminded_at.present? %>
      <div class="mt-2 flex items-start gap-2 text-sm text-orange-900">
        <span class="mt-0.5 shrink-0" aria-hidden="true">🕐</span>
        <div>
          <span class="font-medium">Reminder Sent — Awaiting Payment</span>
          <p class="mt-1 text-xs text-orange-900/90">₹<%= number_with_precision(advance.amount, precision: 2) %> — second reminder sent</p>
          <p class="mt-1 text-xs text-orange-900/90"><%= time_ago_in_words(advance.reminded_at) %> ago</p>
        </div>
      </div>
    <% else %>
      <div class="mt-2 flex items-start gap-2 text-sm text-blue-900">
        <span class="mt-0.5 shrink-0" aria-hidden="true">🕐</span>
        <div>
          <span class="font-medium">Advance Payment Requested</span>
          <p class="mt-1 text-xs text-blue-900/90">₹<%= number_with_precision(advance.amount, precision: 2) %> payment link sent to buyer</p>
          <p class="mt-1 text-xs text-blue-900/90"><%= time_ago_in_words(advance.sent_at) %> ago</p>
          <p class="mt-1 text-xs text-blue-900/90">Reminder sends in 4 hours if unpaid</p>
        </div>
      </div>
    <% end %>
  </div>
</section>
