<%# locals: (notice: nil, alert: nil) %>
<% if notice.present? %>
  <div class="border-b border-green-100 bg-green-50 px-4 py-2 text-sm text-green-800" data-controller="flash" role="status">
    <%= notice %>
  </div>
<% end %>
<% if alert.present? %>
  <div class="border-b border-red-100 bg-red-50 px-4 py-2 text-sm text-red-800" data-controller="flash" role="alert">
    <%= alert %>
  </div>
<% end %>
