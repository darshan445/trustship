<% content_for :title, "Sign up — TrustShip" %>

<h2 class="text-2xl font-semibold text-gray-900">Create your account</h2>
<p class="mt-1 text-sm text-gray-600">Start protecting your orders from RTO</p>

<%= render "sellers/shared/error_messages", resource: resource %>

<%= form_with model: resource, scope: resource_name, url: registration_path(resource_name), local: true, class: "mt-6 space-y-4" do |f| %>
  <div>
    <%= f.label :name, "Full Name", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :phone, "Phone Number", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.telephone_field :phone, autocomplete: "tel", class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :business_name, "Business Name", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_field :business_name, autocomplete: "organization", class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :password, class: "mb-1 block text-sm font-medium text-gray-700" %>
    <% if @minimum_password_length %>
      <span class="text-xs text-gray-500">(<%= @minimum_password_length %> characters minimum)</span>
    <% end %>
    <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :password_confirmation, "Confirm Password", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.submit "Create account", class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
  </div>
<% end %>

<p class="mt-6 text-center text-sm text-gray-600">
  Already have an account?
  <%= link_to "Sign in", new_session_path(resource_name), class: "font-medium text-indigo-600 hover:text-indigo-500" %>
</p>
