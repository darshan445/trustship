<% content_for :title, "Account — TrustShip" %>

<h1 class="text-2xl font-bold text-gray-900">Account</h1>

<div class="mt-8 rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
  <dl class="space-y-4 text-sm">
    <div>
      <dt class="font-medium text-gray-500">Full Name</dt>
      <dd class="mt-0.5 font-medium text-gray-900"><%= current_seller.name %></dd>
    </div>
    <div>
      <dt class="font-medium text-gray-500">Phone</dt>
      <dd class="mt-0.5 font-medium text-gray-900"><%= current_seller.phone %></dd>
    </div>
    <div>
      <dt class="font-medium text-gray-500">Business Name</dt>
      <dd class="mt-0.5 font-medium text-gray-900"><%= current_seller.business_name %></dd>
    </div>
    <div>
      <dt class="font-medium text-gray-500">Member since</dt>
      <dd class="mt-0.5 text-gray-900"><%= current_seller.created_at.strftime("%b %d, %Y") %></dd>
    </div>
    <div>
      <dt class="font-medium text-gray-500">Status</dt>
      <dd class="mt-1">
        <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold <%= current_seller.active? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
          <%= current_seller.status.humanize %>
        </span>
      </dd>
    </div>
  </dl>
</div>

<div class="mt-6 rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-gray-900">Pickup Address</h2>
    <p class="mt-1 text-sm text-gray-600">Use this as your default pickup location for shipping.</p>

    <% if current_seller.pickup_address_saved? %>
      <div class="mt-4 space-y-2 text-sm">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-800">Pickup address saved ✅</span>
        </div>
        <p class="text-gray-900"><%= current_seller.pickup_address_line %></p>
        <p class="text-gray-700"><%= current_seller.pickup_city %>, <%= current_seller.pickup_state %> <%= current_seller.pickup_pincode %></p>
        <p class="text-gray-600">
          <span class="font-medium text-gray-800">Contact:</span>
          <%= current_seller.pickup_name.presence || current_seller.name %>
          · <%= current_seller.pickup_phone.presence || current_seller.phone %>
        </p>
      </div>
      <p class="mt-4">
        <%= link_to "Edit Address →", edit_account_path, class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>
      </p>
    <% else %>
      <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
        <p class="font-medium">Add your pickup address to start shipping</p>
        <p class="mt-3">
          <%= link_to "Add Pickup Address →", edit_account_path, class: "inline-flex rounded-lg bg-amber-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-600" %>
        </p>
      </div>
    <% end %>
</div>

<%= button_to "Sign out", destroy_seller_session_path, method: :delete, class: "mt-8 w-full rounded-lg border-2 border-red-600 bg-white px-5 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-50" %>
