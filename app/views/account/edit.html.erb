<% content_for :title, "Edit Profile — TrustShip" %>

<p class="mb-4">
  <%= link_to "← Back to Account", account_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
</p>

<h1 class="text-2xl font-bold text-gray-900">Edit Profile</h1>

<%= form_with model: @seller, url: account_path, method: :patch, class: "mt-8 space-y-8" do |f| %>
  <section class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-gray-900">Business Details</h2>
    <div class="mt-4 space-y-4">
      <div>
        <%= f.label :name, "Full Name", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name, class: "mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
        <% @seller.errors[:name].each do |msg| %>
          <p class="mt-1 text-sm text-red-600"><%= msg %></p>
        <% end %>
      </div>
      <div>
        <%= f.label :business_name, "Business Name", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :business_name, class: "mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
        <% @seller.errors[:business_name].each do |msg| %>
          <p class="mt-1 text-sm text-red-600"><%= msg %></p>
        <% end %>
      </div>
    </div>
  </section>

  <%= f.submit "Save Changes", class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
<% end %>
